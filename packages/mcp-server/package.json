{
  "name": "@work-learn/mcp-server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts",
    "./direct": "./src/direct.ts",
    "./tools": "./src/tools.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "work-learn-mcp": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@work-learn/local-store": "workspace:*",
    "@work-learn/shared-schema": "workspace:*",
    "zod": "^3.24.1",
    "@supabase/supabase-js": "^2.48.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
