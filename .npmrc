# This machine cannot traverse the directory junctions pnpm creates for
# workspace packages (Windows + this environment), so ESM resolution through
# apps/*/node_modules fails. The hoisted linker copies workspace packages into
# real directories instead, which is why `pnpm test` works here at all.
# CI (ubuntu) is unaffected either way.
# 2026-09-02: the dev machine is now macOS, so the junction rationale above no
# longer applies -- but the hoisted layout is still load-bearing (workspace
# packages are physically copied into apps/*/node_modules, and handoff.md has a
# round dedicated to re-syncing one of those copies). Reverting to the default
# isolated linker needs a full reinstall and is a separate decision.
node-linker=hoisted

# engine-strict is intentionally NOT set: @supabase/supabase-js declares
# engines.node >=22, while this project and CI pin Node 20. Enabling it
# makes pnpm install fail in CI. The root package.json engines field
# (node >=20 <21) still warns on wrong versions.
