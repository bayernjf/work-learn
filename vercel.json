{
  "builds": [
    {
      "src": "api/[[...route]].js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[[...route]].js" }
  ],
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @work-learn/api build:function"
}
