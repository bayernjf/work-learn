{
  "name": "@work-learn/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "macOS menu bar companion for Work Learn: a thin Electron shell over the learn CLI.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron": "^33.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
