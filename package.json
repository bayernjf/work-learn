{
  "name": "work-learn",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:web": "pnpm --filter @work-learn/web dev",
    "dev:api": "pnpm --filter @work-learn/api dev",
    "dev:cli": "pnpm --filter @work-learn/cli dev",
    "dev:companion": "pnpm --filter @work-learn/companion dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "4.86.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "electron"]
  }
}
